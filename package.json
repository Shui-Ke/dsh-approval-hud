{
  "name": "dsh-approval-hud",
  "version": "0.3.3",
  "description": "Always-on-top Windows approval window for DeepSeek Harness: approve or reject tool permissions while you work in other windows.",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.mjs",
  "exports": {
    ".": "./lib/index.mjs",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "ui",
    "docs/*.png",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.1"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "deepseek-harness",
    "approval",
    "permission",
    "always-on-top",
    "windows",
    "wpf"
  ],
  "scripts": {
    "test": "node tests/host.test.mjs",
    "smoke": "node tests/ui-smoke.mjs"
  }
}
